{
  "meta": {
    "node_id": "media_processor_test",
    "action_id": "media_processor_test"
  },
  "config": {
    "max_workers": 4,
    "max_resources": 100,
    "download_size_limit": "50M",
    "total_size_limit": "200M",
    "media_timeout_seconds": 600,
    "connect_timeout_seconds": 10,
    "read_timeout_seconds": 15,
    "max_retries": 1,
    "failure_policy": "continue",
    "object_prefix": "media_resource",
    "download_headers": {},
    "proxy_url": ""
  },
  "inputs": {
    "dict_in": {
      "type": "value",
      "value": {
        "source_id": "example-record",
        "url": "https://example.com/records/1",
        "clean_content": "示例业务记录的完整正文。",
        "raw_content": "{\"text\":\"示例业务记录的完整正文。\",\"media_ids\":[\"image-1\",\"video-1\"]}",
        "media_resources": [
          {
            "source_url": "https://example.com/image.jpg",
            "media_id": "image-1",
            "type": "image",
            "role": "content",
            "width": 1200,
            "height": 800
          },
          {
            "source_url": "https://example.com/video.mp4",
            "media_id": "video-1",
            "type": "video",
            "role": "content"
          },
          {
            "source_url": "https://example.com/poster.jpg",
            "media_id": "video-1",
            "type": "image",
            "role": "poster"
          }
        ]
      }
    }
  },
  "outputs": {
    "dict_out": { "type": "value" }
  }
}
