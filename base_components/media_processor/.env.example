# 运行环境提供 SDK 和 RabbitMQ 连接配置；对象存储凭据只放环境变量。
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# COS / MinIO / S3 兼容存储，需要预先创建存储桶。
COS_ENDPOINT=http://localhost:9000
COS_ACCESS_KEY=your_access_key
COS_SECRET_KEY=your_secret_key
COS_BUCKET=media-bucket
COS_REGION=us-east-1
# 可选：已有可访问的媒体域名；否则使用 endpoint/bucket/key。
COS_BASE_URL=https://cdn.example.com

# 可选：媒体下载代理。
# DOWNLOAD_PROXY=http://localhost:7890
