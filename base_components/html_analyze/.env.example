# RabbitMQ 配置
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# COS (对象存储) 配置 - 用于媒体资源本地化
# MinIO 或其他 S3 兼容服务的配置
COS_ENDPOINT=http://localhost:9000
COS_ACCESS_KEY=your_access_key
COS_SECRET_KEY=your_secret_key
COS_BUCKET=media-bucket
COS_REGION=us-east-1
# 可选：自定义访问域名，如果不设置则使用 endpoint/bucket/filename 格式
COS_BASE_URL=https://cdn.example.com

# 下载代理配置（可选）
# 如果设置，下载媒体资源时将使用该代理
# DOWNLOAD_PROXY=http://192.168.31.200:7890

# 下载线程池配置
MAX_DOWNLOAD_WORKERS=4

# 单条数据的媒体本地化软预算（秒），超时后保留未处理资源的原链接
MEDIA_LOCALIZATION_TIMEOUT_SECONDS=600
# 单条数据最多处理的URL和base64图片数量
MEDIA_LOCALIZATION_MAX_URLS=200
MEDIA_LOCALIZATION_MAX_BASE64_IMAGES=50
# 单条数据的base64累计大小和全部媒体累计大小上限（字节）
MEDIA_LOCALIZATION_MAX_BASE64_TOTAL_BYTES=104857600
MEDIA_LOCALIZATION_MAX_TOTAL_BYTES=209715200

# 媒体下载连接/读取超时（秒）和最大重试次数
MEDIA_DOWNLOAD_CONNECT_TIMEOUT_SECONDS=10
MEDIA_DOWNLOAD_READ_TIMEOUT_SECONDS=30
MEDIA_DOWNLOAD_MAX_RETRIES=1

# COS请求连接/读取超时（秒）和包含首次请求在内的最大尝试次数
COS_CONNECT_TIMEOUT_SECONDS=10
COS_READ_TIMEOUT_SECONDS=30
COS_MAX_ATTEMPTS=2
